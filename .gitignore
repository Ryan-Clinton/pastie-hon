# cast_hosts.json holds local LAN addresses.
.credentials
cast_hosts.json

# ---- PRIVATE DATA ----
# The hOn API returns the appliance's registered GPS coordinates, MAC address
# and serial number in dump/. hue_alert.json holds a personal message and
# tts_cache/ holds it rendered as speech.
dump/
hue_alert.json
tts_cache/
*.log
*.log.prev

